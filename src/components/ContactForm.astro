---
/**
 * A simple enquiry form that delivers to info@datafore.ca through FormSubmit
 * (formsubmit.co), a form-to-email relay that needs no account or server.
 *
 * With JavaScript the form posts to FormSubmit's AJAX endpoint and reports
 * sending / sent / failed in place. Without it, it is an ordinary form post
 * that returns the visitor to /contact/thanks/.
 *
 * FormSubmit holds deliveries for an address until its owner clicks the
 * one-time "Activate" link it emails after the first submission.
 */
import { withBase } from "../lib/paths";

const inbox = "info@datafore.ca";
const action = `https://formsubmit.co/${inbox}`;
const thanksURL = new URL(withBase("/contact/thanks/"), Astro.site).href;

const topics = [
  { value: "snapshot", label: "A Practice Health Snapshot for my clinic" },
  { value: "partner", label: "Partnership, funding or procurement" },
  { value: "other", label: "Something else" },
];

const field =
  "mt-2 block w-full rounded-sm border border-navy-200 bg-paper px-4 py-3 text-base text-graphite-800 transition-colors placeholder:text-graphite-500 hover:border-navy-300 focus:border-signal-500 focus:outline-2 focus:outline-offset-0 focus:outline-signal-500";
const label = "block text-sm font-semibold text-navy-950";
---

<div data-contact>
  <form
    action={action}
    method="POST"
    class="space-y-7"
    data-endpoint={`https://formsubmit.co/ajax/${inbox}`}
    data-inbox={inbox}
  >
    <input type="hidden" name="_subject" value="Website enquiry" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value={thanksURL} />
    <!-- Honeypot: people never see or fill this; bots that do are dropped. -->
    <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />

    <fieldset>
      <legend class={label}>What would you like to discuss?</legend>
      <div class="mt-3 space-y-2.5">
        {
          topics.map((t, i) => (
            <label class="flex cursor-pointer items-start gap-3 text-graphite-800">
              <input
                type="radio"
                name="enquiry"
                value={t.label}
                data-topic={t.value}
                checked={i === 0}
                class="mt-1 size-4 shrink-0 accent-navy-900"
              />
              <span>{t.label}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    <div class="grid gap-7 sm:grid-cols-2">
      <div>
        <label for="cf-name" class={label}>Your name</label>
        <input id="cf-name" name="name" type="text" required autocomplete="name" class={field} />
      </div>
      <div>
        <label for="cf-email" class={label}>Email</label>
        <input id="cf-email" name="email" type="email" required autocomplete="email" class={field} />
      </div>
    </div>

    <div>
      <label for="cf-org" class={label}>
        Clinic or organisation <span class="font-normal text-graphite-600">(optional)</span>
      </label>
      <input id="cf-org" name="organisation" type="text" autocomplete="organization" class={field} />
    </div>

    <div>
      <label for="cf-message" class={label}>Message</label>
      <p id="cf-message-hint" class="mt-1 text-sm text-graphite-600">
        For a Snapshot, it helps to mention your practice management system and roughly how many practitioners and
        locations you have. Please don't include any patient information.
      </p>
      <textarea
        id="cf-message"
        name="message"
        rows="6"
        required
        aria-describedby="cf-message-hint"
        class:list={[field, "resize-y"]}></textarea>
    </div>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
      <button
        type="submit"
        class="self-start rounded-sm bg-navy-900 px-6 py-3.5 font-medium text-white transition-colors hover:bg-navy-700 disabled:cursor-wait disabled:bg-navy-600"
      >
        Send message
      </button>
      <p class="text-sm text-graphite-600">
        Goes straight to {inbox}. See our <a href={withBase("/privacy/")} class="underline underline-offset-4">privacy policy</a>.
      </p>
    </div>

    <p data-error role="alert" class="hidden rounded-sm border border-navy-200 bg-navy-50 px-5 py-4 text-graphite-800"></p>
  </form>

  <div data-success tabindex="-1" class="hidden border-t-2 border-navy-900 pt-6 focus:outline-none">
    <p class="font-display text-[1.75rem] leading-snug text-navy-950">Thank you. Your message is on its way.</p>
    <p class="mt-3 max-w-[52ch] text-lg leading-relaxed text-graphite-700">
      We read every message ourselves and will reply to <span data-success-email class="font-medium text-navy-950"></span> personally.
    </p>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-contact]")) {
    const form = root.querySelector("form")!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = form.querySelector<HTMLElement>("[data-error]")!;
    const success = root.querySelector<HTMLElement>("[data-success]")!;
    const subject = form.querySelector<HTMLInputElement>('input[name="_subject"]')!;
    const inbox = form.dataset.inbox!;

    // Links elsewhere on the site can preselect a topic: /contact/?topic=partner
    const wanted = new URLSearchParams(location.search).get("topic");
    const preset = wanted && form.querySelector<HTMLInputElement>(`input[data-topic="${CSS.escape(wanted)}"]`);
    if (preset) preset.checked = true;

    const showError = (data: FormData) => {
      const body = `${data.get("message") ?? ""}\n\n${data.get("name") ?? ""}\n${data.get("organisation") ?? ""}`.trim();
      const mailto = `mailto:${inbox}?subject=${encodeURIComponent(String(data.get("_subject")))}&body=${encodeURIComponent(body)}`;
      error.replaceChildren(
        "Your message couldn't be sent just now. Please try again, or ",
        Object.assign(document.createElement("a"), {
          href: mailto,
          textContent: `email ${inbox} directly`,
          className: "font-medium text-navy-800 underline decoration-signal-500 underline-offset-4",
        }),
        " — your message will be copied in.",
      );
      error.classList.remove("hidden");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const topic = form.querySelector<HTMLInputElement>('input[name="enquiry"]:checked');
      subject.value = `Website enquiry: ${topic?.value ?? "General"}`;
      const data = new FormData(form);

      error.classList.add("hidden");
      button.disabled = true;
      button.textContent = "Sending…";

      try {
        const response = await fetch(form.dataset.endpoint!, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(data)),
        });
        const result = await response.json().catch(() => ({}));
        if (!response.ok || String(result.success) !== "true") throw new Error(result.message ?? response.statusText);

        root.querySelector<HTMLElement>("[data-success-email]")!.textContent = String(data.get("email"));
        form.classList.add("hidden");
        success.classList.remove("hidden");
        success.focus();
      } catch {
        showError(data);
        button.disabled = false;
        button.textContent = "Send message";
      }
    });
  }
</script>

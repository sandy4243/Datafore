---
import Logo from "./Logo.astro";
import { withBase } from "../lib/paths";
const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-950 text-navy-300">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 py-16 md:grid-cols-12 lg:px-10">
    <div class="md:col-span-5">
      <a href={withBase("/")} class="inline-flex items-center" aria-label="Datafore — home">
        <Logo tone="onDark" />
      </a>
      <p class="mt-3 text-sm font-medium tracking-wide text-signal-300">Forward with Data</p>
      <p class="mt-5 max-w-sm leading-relaxed">
        Clinic intelligence for allied health clinics in Canada.
      </p>
    </div>

    <nav class="md:col-span-3" aria-label="Footer">
      <p class="text-sm font-semibold text-white">Company</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href={withBase("/platform/")} class="hover:text-white">Platform</a></li>
        <li><a href={withBase("/trust/")} class="hover:text-white">Trust &amp; governance</a></li>
        <li><a href={withBase("/blog/")} class="hover:text-white">Insights</a></li>
        <li><a href={withBase("/about/")} class="hover:text-white">About</a></li>
      </ul>
    </nav>

    <div class="md:col-span-4">
      <p class="text-sm font-semibold text-white">Contact</p>
      <ul class="mt-4 space-y-2.5">
        <li><a href="mailto:info@datafore.ca" class="hover:text-white">info@datafore.ca</a></li>
        <li><a href="tel:+17787001733" class="figures hover:text-white">+1 778 700 1733</a></li>
        <li class="leading-relaxed">Datafore Analytics Inc.<br />4353 Halifax Street, Burnaby, BC, Canada</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-800">
    <div class="mx-auto flex max-w-7xl flex-col gap-2 px-6 py-6 text-sm sm:flex-row sm:items-center sm:justify-between lg:px-10">
      <p>&copy; <span class="figures">{year}</span> Datafore Analytics Inc.</p>
      <a href={withBase("/privacy/")} class="hover:text-white">Privacy policy</a>
    </div>
  </div>
</footer>

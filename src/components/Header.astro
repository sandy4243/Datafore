---
const nav = [
  { href: "/", label: "Home" },
  { href: "/platform/", label: "Platform" },
  { href: "/about/", label: "About" },
  { href: "/blog/", label: "Insights" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-ink-100 bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-2">
      <img src="/images/datafore-logo.png" alt="Datafore" class="h-9 w-auto" />
      <span class="text-lg font-semibold text-ink-900">Datafore</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              "text-sm font-medium transition-colors hover:text-brand-600",
              currentPath === item.href ? "text-brand-600" : "text-ink-600",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href="/contact/"
      class="hidden rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 md:inline-block"
    >
      Get in touch
    </a>

    <details class="md:hidden">
      <summary class="list-none rounded-md p-2 text-ink-700 hover:bg-ink-50">
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-full flex flex-col gap-1 border-b border-ink-100 bg-white p-4 shadow-sm">
        {
          nav.map((item) => (
            <a href={item.href} class="rounded-md px-3 py-2 text-sm font-medium text-ink-700 hover:bg-ink-50">
              {item.label}
            </a>
          ))
        }
        <a href="/contact/" class="mt-2 rounded-full bg-brand-600 px-3 py-2 text-center text-sm font-semibold text-white">
          Get in touch
        </a>
      </div>
    </details>
  </div>
</header>

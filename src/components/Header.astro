---
import Logo from "./Logo.astro";
import { withBase } from "../lib/paths";

const nav = [
  { href: withBase("/platform/"), label: "Platform" },
  { href: withBase("/trust/"), label: "Trust" },
  { href: withBase("/blog/"), label: "Insights" },
  { href: withBase("/about/"), label: "About" },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href.replace(/\/+$/, "") || "/") === currentPath;
---

<header class="sticky top-0 z-50 border-b border-navy-100 bg-paper/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <a href={withBase("/")} class="flex items-center" aria-label="Datafore — home">
      <Logo tone="onLight" />
    </a>

    <nav class="hidden items-center gap-9 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            aria-current={isCurrent(item.href) ? "page" : undefined}
            class:list={[
              "text-[0.9375rem] transition-colors hover:text-navy-950",
              isCurrent(item.href)
                ? "text-navy-950 underline decoration-signal-500 decoration-2 underline-offset-[10px]"
                : "text-graphite-600",
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a
      href={withBase("/contact/")}
      class="hidden rounded-sm bg-navy-900 px-5 py-2.5 text-[0.9375rem] font-medium text-white transition-colors hover:bg-navy-700 md:inline-block"
    >
      Start a conversation
    </a>

    <details class="md:hidden">
      <summary class="list-none rounded-sm p-2 text-navy-900 hover:bg-navy-50">
        <span class="sr-only">Menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <div class="absolute inset-x-0 top-full flex flex-col border-b border-navy-100 bg-paper px-6 pb-6 pt-2 shadow-[0_12px_24px_-16px_rgba(10,20,36,0.3)]">
        {
          nav.map((item) => (
            <a href={item.href} class="border-b border-navy-50 py-3.5 text-base text-navy-900">
              {item.label}
            </a>
          ))
        }
        <a href={withBase("/contact/")} class="mt-5 rounded-sm bg-navy-900 px-4 py-3 text-center font-medium text-white">
          Start a conversation
        </a>
      </div>
    </details>
  </div>
</header>

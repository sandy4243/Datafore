---
/**
 * The system's signature mark: a closed loop with one node live.
 * Clinicians already run assess -> treat -> reassess on patients; Datafore runs
 * the same loop on the clinic. The mark is that loop, never decoration.
 */
interface Props {
  size?: number;
  /** Which of the four nodes reads as active (0-3). */
  active?: number;
  class?: string;
}

const { size = 48, active = 0, class: className = "" } = Astro.props;

// Four nodes on the circle, starting at 12 o'clock and moving clockwise.
const nodes = [0, 1, 2, 3].map((i) => {
  const angle = -Math.PI / 2 + (i / 4) * Math.PI * 2;
  return { x: 50 + Math.cos(angle) * 30, y: 50 + Math.sin(angle) * 30, i };
});
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class={className}
  aria-hidden="true"
>
  <!-- Segmented so it reads as flowing rather than static. Stroke weights are
       tuned to stay legible down to ~24px, where the mark is used inline. -->
  <circle
    cx="50"
    cy="50"
    r="30"
    stroke="currentColor"
    stroke-width="5"
    opacity="0.3"
    stroke-linecap="round"
    stroke-dasharray="38 9"
  />
  {
    nodes.map((n) => (
      <circle
        cx={n.x}
        cy={n.y}
        r={n.i === active ? 11 : 6.5}
        fill={n.i === active ? "currentColor" : "none"}
        stroke="currentColor"
        stroke-width="5"
        opacity={n.i === active ? 1 : 0.55}
      />
    ))
  }
  <slot />
</svg>

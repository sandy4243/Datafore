---
/**
 * The home hero's artwork: separate streams of data combining into knowledge,
 * branching into ideas, and one of them carrying forward as action.
 *
 *   Data       four bundles of streamlines, each its own tone, enter from the left
 *   Knowledge  they braid together and meet at one bright point
 *   Ideas      a few branches open out from it, each ending in a small square
 *   Action     one branch continues, brighter, out of the frame: the chosen path
 *
 * On load it draws itself in that order (CSS, .kf-*), then pulses of light keep
 * travelling along the streams and the action line. The resting state is the full
 * drawing; reduced motion shows it at once. Labels show from lg only. Decorative:
 * the hero copy carries the meaning.
 */

// Deterministic randomness, so the drawing is identical on every build.
let state = 20261114;
const rand = () => {
  state = (state + 0x6d2b79f5) | 0;
  let t = Math.imul(state ^ (state >>> 15), 1 | state);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const between = (a: number, b: number) => a + (b - a) * rand();
const r1 = (n: number) => Math.round(n * 10) / 10;

const W = 1000, H = 800;
const K = { x: 540, y: 400 }; // knowledge
const Act = { x: 920, y: 400 }; // where action leaves the other ideas behind

// Data: four distinct streams, each a bundle of lines with its own tone.
const bundles = [
  { y: 130, tone: "stroke-navy-500", width: [0.8, 1.3], count: 14 },
  { y: 300, tone: "stroke-navy-300", width: [0.6, 1.0], count: 10 },
  { y: 510, tone: "stroke-navy-600", width: [1.0, 1.6], count: 16 },
  { y: 680, tone: "stroke-navy-400", width: [0.7, 1.2], count: 12 },
];
const dataLines = bundles.flatMap((b, bi) =>
  Array.from({ length: b.count }, (_, i) => {
    // Each bundle is a tight ribbon that stays apart from the others until late,
    // then braids into the knowledge point.
    const y0 = b.y + between(-24, 24);
    const x0 = between(-160, -40);
    const c1 = { x: between(240, 320), y: y0 + between(-8, 8) };
    const c2 = { x: between(400, 450), y: K.y + (y0 - K.y) * between(0.3, 0.42) };
    const end = { x: K.x - between(2, 8), y: K.y + between(-5, 5) };
    return {
      d: `M ${r1(x0)} ${r1(y0)} C ${r1(c1.x)} ${r1(c1.y)} ${r1(c2.x)} ${r1(c2.y)} ${r1(end.x)} ${r1(end.y)}`,
      tone: b.tone,
      width: r1(between(b.width[0], b.width[1])),
      opacity: r1(between(0.55, 0.95)),
      bundle: bi,
      pulse: i % 5 === 0,
      pulseDelay: Math.round(3200 + between(0, 6000)),
      pulseDur: Math.round(between(5200, 8200)),
    };
  }),
);

// Ideas: branches open out from knowledge; one carries on as action.
const ideaEnds = [250, 340, 470, 560].map((y) => ({ x: between(770, 820), y: y + between(-12, 12) }));
const ideas = ideaEnds.map((e) => ({
  d: `M ${K.x} ${K.y} C ${K.x + 90} ${K.y} ${e.x - 120} ${r1(e.y)} ${r1(e.x)} ${r1(e.y)}`,
  end: e,
}));
const action = `M ${K.x} ${K.y} C ${K.x + 140} ${K.y} ${Act.x - 160} ${Act.y} ${Act.x} ${Act.y} L ${W + 60} ${Act.y}`;

// Each label sits beside the feature it names, clear of the lines.
const labels = [
  { text: "Data", x: 360, y: 412 },
  { text: "Knowledge", x: K.x, y: K.y + 58 },
  { text: "Ideas", x: ideaEnds[0].x, y: ideaEnds[0].y - 28 },
  { text: "Action", x: 950, y: Act.y - 22 },
];
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMaxYMid slice"
  class="knowledge-flow block h-auto w-full lg:h-full"
  data-ambient
  aria-hidden="true"
  focusable="false"
>
  <!-- Data: four streams, each a bundle of lines in its own tone -->
  {
    dataLines.map((l) => (
      <path
        d={l.d}
        pathLength="1"
        class:list={["kf-draw kf-line fill-none", l.tone]}
        style={`--w:${l.width}px;opacity:${l.opacity};--kf-delay:${l.bundle * 140 + Math.round(rand() * 260)}ms;--kf-dur:1600ms`}
        stroke-linecap="round"
      />
    ))
  }

  <!-- Ideas: branches that open out, each ending in a small square -->
  {
    ideas.map((b, i) => (
      <>
        <path
          d={b.d}
          pathLength="1"
          class="kf-draw kf-line fill-none stroke-navy-400"
          style={`--w:1.6px;--kf-delay:${1500 + i * 110}ms;--kf-dur:900ms`}
          stroke-linecap="round"
        />
        <rect
          x={r1(b.end.x - 6)}
          y={r1(b.end.y - 6)}
          width="12"
          height="12"
          rx="1.5"
          class="kf-in kf-line fill-navy-950 stroke-navy-300"
          style={`--w:2px;--kf-delay:${2200 + i * 110}ms`}
        />
      </>
    ))
  }

  <!-- Action: the one path that carries forward -->
  <path
    d={action}
    pathLength="1"
    class="kf-draw kf-line fill-none stroke-signal-500"
    style="--w:3.5px;--kf-delay:2300ms;--kf-dur:1300ms"
    stroke-linecap="round"
  ></path>

  <!-- Knowledge: where the streams meet -->
  <circle cx={K.x} cy={K.y} r="22" class="kf-in kf-line fill-none stroke-navy-500" style="--w:1.2px;--kf-delay:1300ms"></circle>
  <circle cx={K.x} cy={K.y} r="8" class="kf-in kf-line fill-signal-500 stroke-navy-950" style="--w:3px;--kf-delay:1250ms"></circle>

  <!-- Light travelling along the streams, and along the action line -->
  {
    dataLines
      .filter((l) => l.pulse)
      .map((l) => (
        <path
          d={l.d}
          pathLength="1"
          class="kf-pulse kf-line fill-none stroke-signal-300"
          style={`--w:${l.width + 1.2}px;--kf-pdelay:${l.pulseDelay}ms;--kf-pdur:${l.pulseDur}ms`}
          stroke-linecap="round"
        />
      ))
  }
  <path
    d={action}
    pathLength="1"
    class="kf-pulse kf-line fill-none stroke-signal-200"
    style="--w:4.5px;--kf-pdelay:3800ms;--kf-pdur:4200ms"
    stroke-linecap="round"
  ></path>

  <!-- Stage labels (lg and up) -->
  {
    labels.map((l, i) => (
      <text
        x={l.x}
        y={l.y}
        text-anchor="middle"
        class="kf-label kf-in fill-navy-300 font-sans"
        font-size="17"
        style={`--kf-delay:${600 + i * 650}ms`}
      >
        {l.text}
      </text>
    ))
  }
</svg>

---
/**
 * The path one patient record takes: as the practice software holds it; with
 * name and contact details removed, inside the Canadian boundary; and as the
 * recommendation the team sees, with the data behind it. Values are abstract
 * bars and squares, never invented names or numbers. The flag is the one
 * focal (signal) mark. Each panel's caption carries the content.
 * Draws once on scroll (global.css, [data-draw]).
 */
const identifying = ["Patient name", "Phone", "Email"];
const care = [
  { label: "Service", width: "w-[58%]" },
  { label: "Practitioner", width: "w-[44%]" },
];
const visits = 5;
---

<figure data-draw>
  <div class="grid lg:grid-cols-[minmax(0,1fr)_4rem_minmax(0,1fr)_4rem_minmax(0,1fr)] lg:grid-rows-[auto_auto]">
    <!-- 1. The record as the practice software holds it -->
    <div class="d-in border border-navy-100 bg-paper p-6 lg:col-start-1 lg:row-start-1" style="--i:1" aria-hidden="true">
      <p class="text-sm font-semibold text-navy-950">Patient record</p>
      <dl class="mt-4 divide-y divide-navy-100 border-t border-navy-100 text-sm">
        {
          identifying.map((f, i) => (
            <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
              <dt class="text-graphite-600">{f}</dt>
              <dd><span class:list={["block h-2 rounded-sm bg-navy-300", ["w-[70%]", "w-[52%]", "w-[80%]"][i]]} /></dd>
            </div>
          ))
        }
        <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
          <dt class="text-graphite-600">Visits</dt>
          <dd class="flex gap-1.5">{Array.from({ length: visits }, () => <span class="block h-2.5 w-2.5 bg-navy-600" />)}</dd>
        </div>
        {
          care.map((c) => (
            <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
              <dt class="text-graphite-600">{c.label}</dt>
              <dd><span class:list={["block h-2 rounded-sm bg-navy-300", c.width]} /></dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="mt-5 lg:col-start-1 lg:row-start-2 lg:pr-2">
      <h3 class="text-xl leading-snug">In your practice software</h3>
      <p class="mt-2 leading-relaxed text-graphite-700">The full record, as your clinic holds it today.</p>
    </div>

    <div class="flex items-center justify-center py-6 lg:col-start-2 lg:row-start-1 lg:py-0" aria-hidden="true">
      <svg viewBox="0 0 72 24" class="h-6 w-[4rem] rotate-90 lg:rotate-0">
        <path d="M 6 12 H 60" class="d-path stroke-navy-900" pathLength="1" stroke-width="2" stroke-linecap="round" fill="none" style="--i:2"></path>
        <path d="M 56 5 L 68 12 L 56 19 L 59 12 z" class="d-in fill-signal-500" style="--i:3"></path>
      </svg>
    </div>

    <!-- 2. De-identified, inside the Canadian boundary -->
    <div class="d-in border border-dashed border-navy-400 bg-paper p-6 lg:col-start-3 lg:row-start-1" style="--i:3" aria-hidden="true">
      <p class="text-sm font-semibold text-navy-950">Canadian data centres</p>
      <dl class="mt-4 divide-y divide-navy-100 border-t border-navy-100 text-sm">
        {
          identifying.map((f) => (
            <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
              <dt class="text-graphite-500 line-through decoration-graphite-500">{f}</dt>
              <dd class="text-graphite-600">Removed</dd>
            </div>
          ))
        }
        <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
          <dt class="text-graphite-600">Visits</dt>
          <dd class="flex gap-1.5">{Array.from({ length: visits }, () => <span class="block h-2.5 w-2.5 bg-navy-600" />)}</dd>
        </div>
        {
          care.map((c) => (
            <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
              <dt class="text-graphite-600">{c.label}</dt>
              <dd><span class:list={["block h-2 rounded-sm bg-navy-300", c.width]} /></dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="mt-5 lg:col-start-3 lg:row-start-2 lg:pr-2">
      <h3 class="text-xl leading-snug">Private by design, held in Canada</h3>
      <p class="mt-2 leading-relaxed text-graphite-700">
        Names and contact details are removed before analysis. Designed to store and process clinic data in Canadian
        data centres.
      </p>
    </div>

    <div class="flex items-center justify-center py-6 lg:col-start-4 lg:row-start-1 lg:py-0" aria-hidden="true">
      <svg viewBox="0 0 72 24" class="h-6 w-[4rem] rotate-90 lg:rotate-0">
        <path d="M 6 12 H 60" class="d-path stroke-navy-900" pathLength="1" stroke-width="2" stroke-linecap="round" fill="none" style="--i:4"></path>
        <path d="M 56 5 L 68 12 L 56 19 L 59 12 z" class="d-in fill-signal-500" style="--i:5"></path>
      </svg>
    </div>

    <!-- 3. What the team sees: a recommendation with the data behind it -->
    <div class="d-in border border-navy-100 bg-paper p-6 lg:col-start-5 lg:row-start-1" style="--i:5" aria-hidden="true">
      <p class="flex items-center gap-2.5 font-display text-xl text-navy-950">
        <span class="block h-2.5 w-2.5 bg-signal-500"></span>
        Follow up
      </p>
      <p class="mt-1 text-sm text-graphite-700">No next appointment booked.</p>
      <p class="mt-5 border-t border-navy-100 pt-3 text-sm font-semibold text-navy-950">The data behind it</p>
      <dl class="mt-1 divide-y divide-navy-100 text-sm">
        <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
          <dt class="text-graphite-600">Treatment plan</dt>
          <dd class="flex gap-1.5">
            {Array.from({ length: 6 }, (_, i) => <span class:list={["block h-2.5 w-2.5 border", i < 3 ? "border-navy-600 bg-navy-600" : "border-navy-300"]} />)}
          </dd>
        </div>
        <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
          <dt class="text-graphite-600">Last visit</dt>
          <dd><span class="block h-2 w-[40%] rounded-sm bg-navy-300"></span></dd>
        </div>
        <div class="grid grid-cols-[7.5rem_1fr] items-center gap-3 py-2.5">
          <dt class="text-graphite-600">Practitioner</dt>
          <dd><span class="block h-2 w-[44%] rounded-sm bg-navy-300"></span></dd>
        </div>
      </dl>
      <p class="mt-4 border-t border-navy-100 pt-3 text-sm text-graphite-700">Your team decides what happens next.</p>
    </div>
    <div class="mt-5 lg:col-start-5 lg:row-start-2">
      <h3 class="text-xl leading-snug">Accountable AI</h3>
      <p class="mt-2 leading-relaxed text-graphite-700">
        Every recommendation shows the data behind it. People make the decisions.
      </p>
    </div>
  </div>
</figure>

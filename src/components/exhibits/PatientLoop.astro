---
/**
 * One patient who goes quiet, followed through: the closed loop Datafore runs,
 * drawn as six steps on a track. Mechanism only, no figures. The flag step is
 * the one focal (signal) node. Horizontal from lg, vertical below.
 * Draws once on scroll (global.css, [data-draw]); the list is the content.
 */
const steps = [
  { title: "Treatment pauses", body: "Partway through a plan, a patient doesn't book their next visit." },
  { title: "Flagged early", body: "Datafore spots the missing booking while there's still time to act.", focal: true },
  { title: "A task, with an owner", body: "A follow-up task lands in HubSpot, assigned to someone on your team." },
  { title: "Your team calls", body: "They reach out knowing the last visit, the practitioner and the plan." },
  { title: "Back in care", body: "The patient books again and picks up their treatment." },
  { title: "Traced back", body: "The booking is linked to the call, so you see what follow-up brings in." },
];
---

<figure data-draw>
  <ol class="relative grid gap-y-10 lg:grid-cols-6 lg:gap-x-8">
    <!-- The track: vertical below lg, horizontal from lg. -->
    <span class="d-line-y absolute bottom-3 left-[6px] top-3 w-0.5 bg-navy-600 lg:hidden" aria-hidden="true"></span>
    <span
      class="d-line absolute left-[6px] right-[calc((100%-10rem)/6-6px)] top-[6px] hidden h-0.5 bg-navy-600 lg:block"
      aria-hidden="true"></span>

    {
      steps.map((s, i) => (
        <li class="relative pl-10 lg:pl-0">
          <span
            class:list={[
              "d-in absolute left-0 top-1.5 block h-3.5 w-3.5 border-2 lg:static",
              s.focal ? "border-signal-500 bg-signal-500" : "border-navy-300 bg-navy-900",
            ]}
            style={`--i:${i + 1}`}
            aria-hidden="true"
          />
          <div class="d-in lg:mt-6" style={`--i:${i + 1.5}`}>
            <h3 class="text-xl leading-snug text-white">
              {s.title}
            </h3>
            <p class="mt-2 text-base leading-relaxed text-navy-200">{s.body}</p>
          </div>
        </li>
      ))
    }
  </ol>

  <figcaption class="d-in mt-12 flex items-start gap-4 border-t border-navy-700 pt-6 text-navy-200 lg:items-center" style="--i:8">
    <svg viewBox="0 0 40 24" class="mt-0.5 h-6 w-10 shrink-0 lg:mt-0" aria-hidden="true">
      <path d="M 4 18 H 28 a 6 6 0 0 0 0 -12 H 10" class="stroke-navy-400" stroke-width="2" stroke-linecap="round" fill="none"></path>
      <path d="M 13 1 L 2 6 L 13 11 L 10 6 z" class="fill-signal-300"></path>
    </svg>
    <span>Then it runs again, for every patient who goes quiet.</span>
  </figcaption>
</figure>

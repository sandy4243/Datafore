---
/**
 * The hero signature: squares scattered across the navy ground resolve into
 * three streams that merge into one signal-blue arrow. The logo's idea (data
 * resolving into direction), drawn flat. A motif, not the mark: the mark itself
 * is never redrawn.
 *
 * The resting state is the resolved arrow. On load, pure CSS animates each
 * square in from a scattered offset (custom properties below), then draws the
 * streams and the head. Reduced motion shows the resting state at once.
 * Decorative; the hero copy carries the meaning.
 */

// Deterministic randomness, so the composition is identical on every build.
function mulberry32(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = mulberry32(20261114);
const between = (a: number, b: number) => a + (b - a) * rand();
const round = (n: number) => Math.round(n * 10) / 10;

type Pt = [number, number];
const cubic = (p0: Pt, p1: Pt, p2: Pt, p3: Pt, t: number): Pt => {
  const u = 1 - t;
  const a = u * u * u, b = 3 * u * u * t, c = 3 * u * t * t, d = t * t * t;
  return [a * p0[0] + b * p1[0] + c * p2[0] + d * p3[0], a * p0[1] + b * p1[1] + c * p2[1] + d * p3[1]];
};

// The arrow: notch where the streams meet, head pointing right.
const notch: Pt = [492, 220];
const head = "M 470 140 L 612 220 L 470 300 L 500 220 Z";

// Three streams from the scattered left edge into the notch.
const streams: [Pt, Pt, Pt, Pt][] = [
  [[18, 64], [210, 52], [360, 196], notch],
  [[8, 222], [180, 230], [330, 216], notch],
  [[18, 380], [210, 392], [360, 244], notch],
];

// Where squares give way to a drawn line along each stream.
const handoff = 0.6;

const squares: {
  x: number; y: number; s: number; tone: string; o: number;
  dx: number; dy: number; r: number; delay: number;
}[] = [];

streams.forEach(([p0, p1, p2, p3]) => {
  const count = 21;
  for (let k = 0; k < count; k++) {
    const t = (k / (count - 1)) * handoff * between(0.92, 1);
    const [x, y] = cubic(p0, p1, p2, p3, t);
    const progress = t / handoff; // 0 at the far edge, 1 at the line
    const spread = (1 - progress) * 52;
    const s = Math.max(8, between(12, 30) * (1 - progress * 0.6));
    squares.push({
      x: round(Math.max(18, x + between(-spread, spread) * 0.6)),
      y: round(y + between(-spread, spread)),
      s: Math.round(s),
      tone: progress > 0.62 ? "fill-signal-500" : progress > 0.3 ? "fill-navy-500" : "fill-navy-600",
      o: round(between(0.7, 1)),
      dx: Math.round(between(-110, 30) * (1 - progress) - 18),
      dy: Math.round(between(-80, 80) * (1.15 - progress)),
      r: Math.round(between(-35, 35)),
      delay: Math.round(60 + progress * 820 + between(0, 160)),
    });
  }
});

// A few strays that never join a stream: not all data resolves.
for (let k = 0; k < 10; k++) {
  squares.push({
    x: round(between(20, 150)),
    y: round(between(30, 410)),
    s: Math.round(between(7, 14)),
    tone: "fill-navy-700",
    o: 1,
    dx: Math.round(between(-40, 40)),
    dy: Math.round(between(-40, 40)),
    r: Math.round(between(-30, 30)),
    delay: Math.round(between(0, 300)),
  });
}

// The drawn part of each stream: from the handoff to the notch.
const streamPaths = streams.map(([p0, p1, p2, p3]) => {
  const pts: Pt[] = [];
  for (let i = 0; i <= 24; i++) pts.push(cubic(p0, p1, p2, p3, handoff + ((1 - handoff) * i) / 24));
  return "M " + pts.map(([x, y]) => `${round(x)} ${round(y)}`).join(" L ");
});
---

<svg viewBox="0 0 640 440" class="signal-field h-auto w-full" aria-hidden="true" focusable="false">
  {
    squares.map((q) => (
      <rect
        class:list={["sf-sq", q.tone]}
        x={q.x - q.s / 2}
        y={q.y - q.s / 2}
        width={q.s}
        height={q.s}
        rx="1.5"
        opacity={q.o}
        style={`--dx:${q.dx}px;--dy:${q.dy}px;--r:${q.r}deg;--delay:${q.delay}ms`}
      />
    ))
  }
  {streamPaths.map((d) => <path class="sf-stream stroke-signal-500" d={d} pathLength="1" fill="none" stroke-width="5" stroke-linecap="round" />)}
  <path class="sf-head fill-signal-500" d={head}></path>
</svg>

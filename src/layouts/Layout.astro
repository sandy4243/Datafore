---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase, isPreviewDeploy } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = title === "Datafore" ? title : `${title} · Datafore`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Social cards need an absolute URL, not a root-relative path.
const ogImage = new URL(withBase("/images/og-datafore.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#10204d" />
    <link rel="canonical" href={canonicalURL} />
    {/* The Pages copy is a review build; keep it out of search results. */}
    {isPreviewDeploy && <meta name="robots" content="noindex, nofollow" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Datafore" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Datafore — clinic intelligence for Canadian allied health." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

  </head>
  <body>
    <!--
      THESIS: Datafore as a trusted advisor to clinic leaders, not a tool vendor. The page argues
      outcomes, partnership and stewardship; mechanism is supporting evidence, not the headline.
      OWN-WORLD: Premium advisory brief. White page, wordmark navy, the logo's signal blue as a sparing
      accent. Source Serif 4 for the voice, Public Sans for everything functional. Hairline rules,
      wide margins, full-bleed navy bands for the statements that matter. No monospace, no cards-as-structure.
      STORY: A clinic owner sees their business understood at the level of strategy, believes Datafore
      can be trusted with patient data, and starts a conversation. An evaluator finds governance in one click.
      FIRST VIEWPORT: Navy band. A serif statement of the outcome at display size, a one-paragraph
      positioning line, two actions; a quiet right column naming the three decisions we help leaders make.
      FORM: User-pinned direction ("Premium advisory"), brief-chosen; no concept roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

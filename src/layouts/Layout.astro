---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase, isPreviewDeploy } from "../lib/paths";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Keep a utility page (e.g. a form confirmation) out of search results. */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const pageTitle = title === "Datafore" ? title : `${title} · Datafore`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
// Social cards need an absolute URL, not a root-relative path.
const ogImage = new URL(withBase("/images/og-datafore.png"), Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase("/favicon.ico")} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase("/favicon-32.png")} />
    <link rel="apple-touch-icon" href={withBase("/apple-touch-icon.png")} />
    <meta name="theme-color" content="#031a4c" />
    <link rel="canonical" href={canonicalURL} />
    {/* The Pages copy is a review build; keep it out of search results. */}
    {isPreviewDeploy && <meta name="robots" content="noindex, nofollow" />}
    {noindex && !isPreviewDeploy && <meta name="robots" content="noindex" />}

    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Datafore" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Datafore — clinic intelligence for Canadian allied health." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* Before first paint, so exhibits start undrawn only when the script that draws them will run. */}
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <!--
      THESIS: Datafore as a trusted advisor to clinic leaders, not a tool vendor. The page argues
      outcomes, partnership and stewardship; mechanism is supporting evidence, not the headline.
      OWN-WORLD: Premium advisory brief. White page, wordmark navy, the logo's signal blue as a sparing
      accent. Source Serif 4 for the voice, Public Sans for everything functional. Hairline rules,
      wide margins, full-bleed navy bands for the statements that matter. No monospace, no cards-as-structure.
      STORY: A clinic owner sees their business understood at the level of strategy, believes Datafore
      can be trusted with patient data, and starts a conversation. An evaluator finds governance in one click.
      FIRST VIEWPORT: Navy band. A serif statement at display size, a one-paragraph positioning line, two
      actions; on the right the signature (scattered squares resolving into one arrow); below, the questions we answer.
      EXHIBITS: every pitch page draws the mechanism (src/components/exhibits), never invented results.
      FORM: User-pinned direction ("Premium advisory"), brief-chosen; no concept roll.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
    -->
    <a
      href="#main"
      class="sr-only rounded-sm bg-navy-900 px-4 py-3 font-medium text-white focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[60]"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      // Exhibits draw once, about a fifth of the way into view (see global.css).
      const exhibits = document.querySelectorAll<HTMLElement>("[data-draw]");
      if (!("IntersectionObserver" in window)) {
        exhibits.forEach((el) => el.classList.add("is-drawn"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("is-drawn");
              io.unobserve(e.target);
            }
          },
          { threshold: 0.2, rootMargin: "0px 0px -8% 0px" },
        );
        exhibits.forEach((el) => io.observe(el));

        // Ambient artwork moves only while it is on screen.
        const ambient = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.classList.toggle("is-paused", !e.isIntersecting);
        });
        document.querySelectorAll("[data-ambient]").forEach((el) => ambient.observe(el));
      }
    </script>
  </body>
</html>

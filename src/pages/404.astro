---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-32 text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
    <h1 class="mt-3 text-3xl font-bold text-ink-900">We couldn't find that page.</h1>
    <p class="mt-4 text-ink-600">The page you're looking for may have moved or no longer exists.</p>
    <a
      href="/"
      class="mt-8 inline-block rounded-full bg-brand-600 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-700"
    >
      Back to home
    </a>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto max-w-7xl px-6 pb-32 pt-24 md:pt-32 lg:px-10">
    <h1 class="max-w-[18ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl">
      We couldn't find that page.
    </h1>
    <p class="mt-8 max-w-[52ch] text-lg leading-relaxed text-graphite-700">
      It may have moved when we updated the site, or it may no longer exist.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
      <a
        href={withBase("/")}
        class="rounded-sm bg-navy-900 px-6 py-3.5 font-medium text-white transition-colors hover:bg-navy-700"
      >
        Back to home
      </a>
      <a
        href={withBase("/contact/")}
        class="font-medium text-navy-800 underline decoration-signal-500 underline-offset-[6px] hover:decoration-2"
      >
        Contact us
      </a>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
---

<Layout title="Page not found" description="This page doesn't exist.">
  <section class="mx-auto flex max-w-2xl flex-col items-center px-6 py-32 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.14em] text-seal-600">404</p>
    <h1 class="mt-3 text-3xl font-bold text-ink-950">We couldn't find that page.</h1>
    <p class="mt-4 text-ink-600">The page you're looking for may have moved or no longer exists.</p>
    <a
      href={withBase("/")}
      class="mt-8 inline-block rounded bg-ink-950 px-6 py-3 font-mono text-sm uppercase tracking-[0.08em] text-white hover:bg-seal-700"
    >
      Back to home
    </a>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-6 py-16 md:py-20">
    <p class="font-mono text-xs uppercase tracking-wide text-graphite-500">
      <span>
        {
          post.data.publishDate.toLocaleDateString("en-CA", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
      </span>
      <span class="px-1.5 text-graphite-300">&middot;</span>
      <span>{post.data.author}</span>
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-graphite-950">{post.data.title}</h1>
    <div class="prose prose-neutral mt-10 max-w-none text-graphite-700">
      <Content />
    </div>
  </article>
</Layout>

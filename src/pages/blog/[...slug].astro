---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article>
    <header class="border-b border-navy-100">
      <div class="mx-auto max-w-4xl px-6 pb-14 pt-16 md:pt-24">
        <a
          href={withBase("/blog/")}
          class="text-sm font-medium text-navy-800 underline decoration-signal-500 underline-offset-4"
        >
          All insights
        </a>
        <h1 class="mt-8 text-[2.5rem] leading-[1.08] tracking-[-0.02em] md:text-[3.5rem]">{post.data.title}</h1>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-graphite-700 md:text-xl">{post.data.description}</p>
        <p class="mt-8 text-sm text-graphite-600">
          <span class="font-semibold text-navy-950">{post.data.author}</span>
          <span class="px-2 text-graphite-300" aria-hidden="true">/</span>
          <time datetime={post.data.publishDate.toISOString()} class="figures">
            {
              post.data.publishDate.toLocaleDateString("en-CA", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
        </p>
      </div>
    </header>
    <div class="mx-auto max-w-4xl px-6 py-14 md:py-20">
      <div class="prose prose-lg max-w-[68ch]">
        <Content />
      </div>
    </div>
  </article>
</Layout>

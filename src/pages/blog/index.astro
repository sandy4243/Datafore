---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/paths";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Insights"
  description="Notes from Datafore on running the business side of an allied health clinic — what the numbers show, and what to do about them."
>
  <section class="border-b border-graphite-200 bg-bone">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <h1 class="text-4xl font-bold tracking-tight text-graphite-950 md:text-5xl">Insights</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-graphite-600">
        Notes on running the business side of an allied health clinic — what the numbers show, and what to do
        about them.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    {posts.length === 0 && <p class="text-graphite-600">New posts are on the way.</p>}
    <ul class="divide-y divide-graphite-200 border-t border-graphite-200">
      {
        posts.map((post) => (
          <li class="py-10 first:pt-0">
            <a href={withBase(`/blog/${post.id}/`)} class="group">
              <p class="font-mono text-xs uppercase tracking-wide text-graphite-500">
                {post.data.publishDate.toLocaleDateString("en-CA", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <h2 class="mt-2 text-2xl font-semibold text-graphite-950 group-hover:text-vital-700">{post.data.title}</h2>
              <p class="mt-2 leading-relaxed text-graphite-600">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

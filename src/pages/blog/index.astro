---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<Layout
  title="Insights"
  description="Notes from Datafore on analytics, operations, and data for allied health clinics in BC."
>
  <section class="border-b border-ink-100 bg-brand-50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <h1 class="text-4xl font-bold tracking-tight text-ink-900 md:text-5xl">Insights</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">
        Notes from Datafore on analytics, operations, and data for allied health clinics.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    {posts.length === 0 && <p class="text-ink-600">New posts are on the way.</p>}
    <ul class="space-y-10">
      {
        posts.map((post) => (
          <li class="border-b border-ink-100 pb-10 last:border-none">
            <a href={`/blog/${post.id}/`} class="group">
              <p class="text-sm text-ink-500">
                {post.data.publishDate.toLocaleDateString("en-CA", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </p>
              <h2 class="mt-2 text-2xl font-semibold text-ink-900 group-hover:text-brand-600">{post.data.title}</h2>
              <p class="mt-2 leading-relaxed text-ink-600">{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

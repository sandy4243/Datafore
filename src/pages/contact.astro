---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact"
  description="Get in touch with Datafore — join the early access list, or talk to us about analytics for your allied health clinic in BC."
>
  <section class="border-b border-ink-100 bg-brand-50">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <h1 class="text-4xl font-bold tracking-tight text-ink-900 md:text-5xl">Talk to Datafore</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">
        Whether you run an allied health clinic in BC, work in one, or just want to know more about what we're
        building — reach out. We read every message ourselves.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="grid gap-8 sm:grid-cols-2">
      <a
        href="mailto:info@datafore.ca"
        class="rounded-2xl border border-ink-100 p-6 transition-colors hover:border-brand-300 hover:bg-brand-50"
      >
        <h2 class="text-lg font-semibold text-ink-900">Email</h2>
        <p class="mt-2 text-brand-600">info@datafore.ca</p>
      </a>
      <a
        href="tel:+17787001733"
        class="rounded-2xl border border-ink-100 p-6 transition-colors hover:border-brand-300 hover:bg-brand-50"
      >
        <h2 class="text-lg font-semibold text-ink-900">Phone</h2>
        <p class="mt-2 text-brand-600">+1 778 700 1733</p>
      </a>
    </div>

    <div class="mt-8 rounded-2xl border border-ink-100 p-6">
      <h2 class="text-lg font-semibold text-ink-900">Office</h2>
      <p class="mt-2 text-ink-600">4353 Halifax Street, Burnaby, BC, Canada</p>
    </div>
  </section>
</Layout>

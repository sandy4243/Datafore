---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact"
  description="Start a conversation with Datafore — request a complimentary Practice Health Snapshot for your clinic, or get in touch about partnerships and evaluations."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="max-w-[16ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4.5rem]">
        Start a conversation.
      </h1>
      <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Whether you lead a clinic or are evaluating Datafore as a partner, we read every message ourselves and reply
        personally.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
    <div class="grid gap-px overflow-hidden rounded-sm border border-navy-100 bg-navy-100 lg:grid-cols-2">
      <div class="flex flex-col bg-paper p-8 md:p-12">
        <h2 class="text-[1.75rem] leading-[1.15] md:text-[2.25rem]">For clinic leaders</h2>
        <p class="mt-5 flex-1 text-lg leading-relaxed text-graphite-700">
          Request a complimentary Practice Health Snapshot. We'll look at your own data — utilisation, patient
          attrition, revenue mix — and show you where value is leaking. The findings are yours, whatever you decide
          next.
        </p>
        <p class="mt-5 text-graphite-600">
          It helps to mention which practice management system you use, and roughly how many practitioners and
          locations you have.
        </p>
        <a
          href="mailto:info@datafore.ca?subject=Practice%20Health%20Snapshot"
          class="mt-8 self-start rounded-sm bg-navy-900 px-6 py-3.5 font-medium text-white transition-colors hover:bg-navy-700"
        >
          Request a Snapshot
        </a>
      </div>

      <div class="flex flex-col bg-paper p-8 md:p-12">
        <h2 class="text-[1.75rem] leading-[1.15] md:text-[2.25rem]">For partners and evaluators</h2>
        <p class="mt-5 flex-1 text-lg leading-relaxed text-graphite-700">
          For partnerships, funding applications, procurement or research collaboration, write to us and we'll set up
          a time to walk through our approach, architecture and governance in detail.
        </p>
        <a
          href="mailto:info@datafore.ca?subject=Partnership%20or%20evaluation%20enquiry"
          class="mt-8 self-start rounded-sm border border-navy-900 px-6 py-3.5 font-medium text-navy-900 transition-colors hover:bg-navy-50"
        >
          Get in touch
        </a>
      </div>
    </div>

    <dl class="mt-16 grid gap-10 border-t border-navy-100 pt-10 sm:grid-cols-3">
      <div>
        <dt class="text-sm font-semibold text-navy-950">Email</dt>
        <dd class="mt-2 text-lg"><a href="mailto:info@datafore.ca" class="text-navy-800 underline decoration-signal-500 underline-offset-4">info@datafore.ca</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-navy-950">Phone</dt>
        <dd class="figures mt-2 text-lg"><a href="tel:+17787001733" class="text-navy-800 underline decoration-signal-500 underline-offset-4">+1 778 700 1733</a></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-navy-950">Office</dt>
        <dd class="mt-2 text-lg leading-relaxed text-graphite-700">4353 Halifax Street<br />Burnaby, BC, Canada</dd>
      </div>
    </dl>
  </section>
</Layout>

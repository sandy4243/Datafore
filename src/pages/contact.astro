---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact"
  description="Get in touch with Datafore — join the early access list, or talk to us about the platform for your allied health clinic in BC."
>
  <section class="border-b border-ink-200 bg-paper">
    <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
      <h1 class="text-4xl font-bold tracking-tight text-ink-950 md:text-5xl">Talk to Datafore</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">
        Whether you run an allied health clinic in BC, work in one, or just want to know more about what we're
        building — reach out. We read every message ourselves.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-6 py-16">
    <div class="grid gap-6 sm:grid-cols-2">
      <a
        href="mailto:info@datafore.ca"
        class="rounded-lg border border-ink-200 p-6 transition-colors hover:border-seal-400 hover:bg-paper-dim"
      >
        <p class="credential-label text-seal-600">Email</p>
        <p class="mt-2 text-lg font-medium text-ink-950">info@datafore.ca</p>
      </a>
      <a
        href="tel:+17787001733"
        class="rounded-lg border border-ink-200 p-6 transition-colors hover:border-seal-400 hover:bg-paper-dim"
      >
        <p class="credential-label text-seal-600">Phone</p>
        <p class="mt-2 text-lg font-medium text-ink-950">+1 778 700 1733</p>
      </a>
    </div>

    <div class="mt-6 rounded-lg border border-ink-200 p-6">
      <p class="credential-label text-seal-600">Office</p>
      <p class="mt-2 text-lg font-medium text-ink-950">4353 Halifax Street, Burnaby, BC, Canada</p>
    </div>
  </section>
</Layout>

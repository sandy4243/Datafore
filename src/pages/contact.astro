---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";

const bookingURL = "https://calendly.com/sandeep-datafore/initial";
---

<Layout
  title="Contact"
  description="Start a conversation with Datafore — book an introductory call, request a complimentary Practice Health Snapshot for your clinic, or get in touch about partnerships and evaluations."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="max-w-[16ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4.5rem]">
        Start a conversation.
      </h1>
      <p class="mt-8 max-w-[60ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Whether you lead a clinic or are evaluating Datafore as a partner, we read every message ourselves and reply
        personally. Book a time to talk, or send us a note below.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-28">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-10">
      <div id="message" class="scroll-mt-28 lg:col-span-7">
        <h2 class="text-[2rem] leading-[1.12] md:text-[2.5rem]">Send us a message.</h2>
        <div class="mt-10">
          <ContactForm />
        </div>
      </div>

      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="bg-navy-900 p-8 text-navy-200">
          <h2 class="text-[1.75rem] leading-[1.15] text-white">Prefer to talk?</h2>
          <p class="mt-4 leading-relaxed">
            Book an introductory call with Sandeep at a time that suits you. We'll talk through your clinic or your
            evaluation, and what a sensible first step would be.
          </p>
          <a
            href={bookingURL}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-7 inline-block rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Book a call<span class="sr-only"> (opens Calendly in a new tab)</span>
          </a>
        </div>

        <dl class="mt-12 space-y-7">
          <div>
            <dt class="text-sm font-semibold text-navy-950">Email</dt>
            <dd class="mt-1.5 text-lg">
              <a href="mailto:info@datafore.ca" class="text-navy-800 underline decoration-signal-500 underline-offset-4">info@datafore.ca</a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-navy-950">Phone</dt>
            <dd class="figures mt-1.5 text-lg">
              <a href="tel:+17787001733" class="text-navy-800 underline decoration-signal-500 underline-offset-4">+1 778 700 1733</a>
            </dd>
          </div>
          <div>
            <dt class="text-sm font-semibold text-navy-950">Office</dt>
            <dd class="mt-1.5 text-lg leading-relaxed text-graphite-700">4353 Halifax Street<br />Burnaby, BC, Canada</dd>
          </div>
        </dl>
      </aside>
    </div>
  </section>
</Layout>

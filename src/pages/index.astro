---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
import EngagementCycle from "../components/EngagementCycle.astro";
import FounderNote from "../components/FounderNote.astro";

const questions = [
  "Which patients have stopped coming, and who should call them?",
  "Which hours go unbooked, and for which practitioners?",
  "Is your marketing bringing in patients?",
];

const outcomes = [
  {
    title: "More patients finish their care",
    body: "Patients who stop booking are flagged early, while there is still time to bring them back.",
  },
  {
    title: "A fuller schedule",
    body: "See open time by practitioner, day and service, early enough to fill it.",
  },
  {
    title: "Revenue you understand",
    body: "Know what each service, payer and practitioner brings in, and which invoices are overdue.",
  },
  {
    title: "Spending that pays back",
    body: "Judge marketing, hiring and new locations by the bookings they produce.",
  },
];

const engagement = [
  {
    name: "Diagnose",
    body: "A Practice Health Snapshot: a review of your own data that shows where patients, hours and revenue are slipping.",
  },
  {
    name: "Prioritise",
    body: "We agree on the few numbers that matter most to your clinic, with targets you can hold us to.",
  },
  {
    name: "Activate",
    body: "Datafore connects to your systems and turns each finding into a follow-up task for your team.",
  },
  {
    name: "Review",
    body: "We meet regularly to look at what improved, what didn't, and what to try next.",
  },
];

const principles = [
  {
    title: "Held in Canada",
    body: "Designed to store and process clinic data in Canadian data centres.",
  },
  {
    title: "Private by design",
    body: "Analysis runs on de-identified records. Names and contact details stay out.",
  },
  {
    title: "Accountable AI",
    body: "Every recommendation shows the data behind it. People make the decisions.",
  },
];
---

<Layout
  title="Datafore"
  description="Datafore shows allied health clinics in Canada where patients, hours and revenue are slipping away, and helps them act on it."
>
  <!-- Hero -->
  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 pb-24 pt-20 md:pt-28 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:pb-32">
      <div class="settle lg:col-span-8">
        <h1 class="text-[2.75rem] leading-[1.04] tracking-[-0.022em] text-white sm:text-6xl lg:text-[5rem]">
          Clinic intelligence for the business of care.
        </h1>
        <p class="mt-8 max-w-[58ch] text-lg leading-relaxed md:text-xl">
          Datafore shows allied health clinics where patients, hours and revenue are slipping away, and helps them act
          on it.
        </p>
        <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={withBase("/contact/")}
            class="rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Start a conversation
          </a>
          <a
            href={withBase("/platform/")}
            class="font-medium text-white underline decoration-signal-300 decoration-1 underline-offset-[6px] hover:decoration-2"
          >
            How it works
          </a>
        </div>
      </div>

      <aside class="settle-late self-end border-t border-navy-700 pt-6 lg:col-span-4 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <h2 class="font-sans text-sm font-semibold tracking-normal text-white">Questions we answer</h2>
        <ul class="mt-5 divide-y divide-navy-800">
          {
            questions.map((d) => (
              <li class="py-4 font-display text-xl leading-snug text-navy-100">{d}</li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- The opportunity -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">
        Your practice software records everything and explains nothing.
      </h2>
      <div class="space-y-6 text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        <p>
          Jane, Cliniko and Owl Practice log every appointment, invoice and cancellation. They were built for
          booking and billing, so decisions on hiring, hours and marketing get made on instinct and month-end
          spreadsheets.
        </p>
        <p>
          Meanwhile, no-shows, empty slots and patients who stop coming are estimated to cost clinics 10 to 20 percent
          of their revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <h2 class="max-w-[22ch] text-[2rem] leading-[1.12] md:text-[2.75rem]">What changes for your clinic.</h2>
      <div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
        {
          outcomes.map((o) => (
            <div class="border-t border-navy-200 pt-6">
              <h3 class="text-2xl leading-snug">{o.title}</h3>
              <p class="mt-3 max-w-[48ch] leading-relaxed text-graphite-700">{o.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Point of view -->
  <section class="bg-navy-900 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <blockquote class="max-w-5xl">
        <p class="font-display text-[1.875rem] leading-[1.2] text-white md:text-[2.75rem] lg:text-[3.25rem]">
          Practice software records care. Clinic owners need help running the business.
        </p>
      </blockquote>
      <p class="mt-10 max-w-[62ch] text-lg leading-relaxed">
        Datafore sits on top of the software you already use. It turns what it finds into follow-up for your team,
        then shows what each follow-up brought in.
      </p>
    </div>
  </section>

  <!-- Engagement model -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">How we work with you.</h2>
      </div>
      <p class="text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        The way a good clinician treats a patient: assess, agree a plan, act, then reassess.
      </p>
    </div>

    <div class="mt-16 grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="flex justify-center lg:col-span-5 lg:justify-start">
        <EngagementCycle />
      </div>
      <ol class="divide-y divide-navy-100 border-y border-navy-100 lg:col-span-6 lg:col-start-7">
        {
          engagement.map((s) => (
            <li class="py-6">
              <h3 class="text-2xl">{s.name}</h3>
              <p class="mt-2 leading-relaxed text-graphite-700">{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Founder's note -->
  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <FounderNote heading="A note from our founder.">
        <p>
          Datafore began as a data and analytics consultancy. I kept seeing the same thing: good data, good reports,
          and very little changing as a result.
        </p>
        <p>
          Allied health clinics feel this more than most. Their owners are clinicians first, running a business on
          software built for booking and billing. They deserve the kind of insight large health systems take for
          granted.
        </p>
        <p>
          I started Datafore to give them that, beginning here in British Columbia. If that sounds like your clinic,
          I'd like to hear from you.
        </p>
        <a
          slot="after"
          href={withBase("/about/")}
          class="mt-5 inline-block font-medium text-navy-800 underline decoration-signal-500 underline-offset-[6px] hover:decoration-2"
        >
          More about Datafore
        </a>
      </FounderNote>
    </div>
  </section>

  <!-- Trust -->
  <section>
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">Built for patient data.</h2>
          <p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-graphite-700">
            Health information is the most sensitive thing a clinic holds. Protecting it is part of Datafore's design
            from the start.
          </p>
          <a
            href={withBase("/trust/")}
            class="mt-8 inline-block font-medium text-navy-800 underline decoration-signal-500 underline-offset-[6px] hover:decoration-2"
          >
            How we protect clinic data
          </a>
        </div>
        <div class="grid gap-10 sm:grid-cols-3 lg:col-span-6 lg:col-start-7 lg:gap-8">
          {
            principles.map((p) => (
              <div class="border-t border-navy-200 pt-6">
                <h3 class="font-sans text-base font-semibold tracking-normal">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-graphite-700">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Founding cohort -->
  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-[2rem] leading-[1.12] text-white md:text-[3rem]">Be one of our first clinics.</h2>
          <p class="mt-6 max-w-[56ch] text-lg leading-relaxed">
            We're inviting a small group of BC allied health clinics to work with us first, starting with a free
            Practice Health Snapshot of your own data.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 lg:col-span-5 lg:justify-end">
          <a
            href={withBase("/contact/?topic=snapshot#message")}
            class="rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Request a Snapshot
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
import KnowledgeFlow from "../components/art/KnowledgeFlow.astro";
import PatientLoop from "../components/exhibits/PatientLoop.astro";
import ServiceBlueprint from "../components/exhibits/ServiceBlueprint.astro";
import FlowArt from "../components/art/FlowArt.astro";
import { getCollection } from "astro:content";

// The newest published report, for the "From our research" section.
const [latest] = (await getCollection("reports", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const questions = [
  "Which patients have stopped coming, and who should call them?",
  "Which hours go unbooked, and for which practitioners?",
  "Is your marketing bringing in patients?",
];

const outcomes = [
  {
    title: "More patients finish their care",
    body: "Patients who stop booking are flagged early, while there is still time to bring them back.",
  },
  {
    title: "A fuller schedule",
    body: "See open time by practitioner, day and service, early enough to fill it.",
  },
  {
    title: "Revenue you understand",
    body: "Know what each service, payer and practitioner brings in, and which invoices are overdue.",
  },
  {
    title: "Spending that pays back",
    body: "Judge marketing, hiring and new locations by the bookings they produce.",
  },
];
---

<Layout
  title="Datafore"
  description="Datafore shows allied health clinics in Canada where patients, hours and revenue are slipping away, and helps them act on it."
>
  <!-- Hero: the statement, and the artwork (streams of data combining into knowledge, ideas, action) -->
  <section class="overflow-hidden bg-navy-950 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 pb-16 lg:px-10 lg:pb-20 lg:pt-28">
      <div class="relative">
        <!-- Below lg a full-width banner; from lg it bleeds off the right edge behind a mask. -->
        <div
          class="-mx-6 lg:absolute lg:-top-28 lg:bottom-[-2rem] lg:left-[42%] lg:right-[calc((100%-100vw)/2)] lg:mx-0 lg:[mask-image:linear-gradient(to_right,transparent,black_36%)]"
        >
          <KnowledgeFlow />
        </div>
        <div class="settle relative mt-10 lg:mt-0 lg:max-w-[46rem]">
          <!-- "Artificial" is struck through, with "Real" beside it on the same line as the correction. -->
          <h1
            aria-label="Real Intelligence for the business of care."
            class="text-[2.75rem] leading-[1.04] tracking-[-0.022em] text-white sm:text-6xl lg:text-[5rem]"
          >
            <span aria-hidden="true">
              <span class="line-through decoration-signal-300 decoration-[0.06em]">Artificial</span>{" "}<span class="font-semibold italic">Real</span>{" "}Intelligence for the business of care.
            </span>
          </h1>
          <p class="mt-8 max-w-[46ch] text-lg leading-relaxed md:text-xl">
            Datafore shows allied health clinics where patients, hours and revenue are slipping away, and helps them
            act on it.
          </p>
          <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-4">
            <a
              href={withBase("/contact/?topic=snapshot#message")}
              class="rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
            >
              Request a Snapshot
            </a>
            <a
              href={withBase("/platform/")}
              class="font-medium text-white underline decoration-signal-300 decoration-1 underline-offset-[6px] hover:decoration-2"
            >
              See the platform
            </a>
          </div>
        </div>
      </div>

      <div class="settle-late relative mt-16 grid gap-6 border-t border-navy-800 pt-8 lg:mt-24 lg:grid-cols-12 lg:gap-10">
        <h2 class="font-sans text-sm font-semibold tracking-normal text-white lg:col-span-3">Questions we answer</h2>
        <ul class="grid gap-6 sm:grid-cols-3 sm:gap-8 lg:col-span-9">
          {questions.map((q) => <li class="font-display text-xl leading-snug text-navy-100">{q}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- The opportunity -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">
        Your practice software records everything and explains nothing.
      </h2>
      <div class="space-y-6 text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        <p>
          Jane, Cliniko and Owl Practice log every appointment, invoice and cancellation. They were built for
          booking and billing, so decisions on hiring, hours and marketing get made on instinct and month-end
          spreadsheets.
        </p>
        <p>
          Meanwhile, no-shows, empty slots and patients who stop coming are estimated to cost clinics 10 to 20 percent
          of their revenue.
        </p>
      </div>
    </div>
  </section>

  <!-- Exhibit: one patient's loop -->
  <section class="bg-navy-900 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
        <h2 class="text-[2rem] leading-[1.12] text-white md:text-[2.75rem] lg:col-span-6">
          What happens when a patient goes quiet.
        </h2>
        <p class="max-w-[52ch] text-lg leading-relaxed lg:col-span-5 lg:col-start-8 lg:self-end">
          Your practice software won't tell you. Datafore follows each one through, from the missed booking to the call
          that brings them back.
        </p>
      </div>
      <div class="mt-16 lg:mt-20">
        <PatientLoop />
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <h2 class="max-w-[22ch] text-[2rem] leading-[1.12] md:text-[2.75rem]">What changes for your clinic.</h2>
      <div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
        {
          outcomes.map((o) => (
            <div class="border-t border-navy-200 pt-6">
              <h3 class="text-2xl leading-snug">{o.title}</h3>
              <p class="mt-3 max-w-[48ch] leading-relaxed text-graphite-700">{o.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Exhibit: the engagement as a service blueprint -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">How we work with you.</h2>
      <p class="max-w-[52ch] text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7 lg:self-end">
        The way a good clinician treats a patient: assess, agree a plan, act, then reassess. You see the plan and the
        progress; the platform does the watching.
      </p>
    </div>
    <div class="mt-16">
      <ServiceBlueprint />
    </div>
    <p class="mt-12 flex flex-wrap gap-x-10 gap-y-4">
      <a
        href={withBase("/contact/?topic=snapshot#message")}
        class="font-medium text-navy-950 underline decoration-signal-500 decoration-1 underline-offset-[6px] hover:decoration-2"
      >
        Start with a free Practice Health Snapshot
      </a>
      <a
        href={withBase("/platform/#patient-data")}
        class="font-medium text-navy-950 underline decoration-signal-500 decoration-1 underline-offset-[6px] hover:decoration-2"
      >
        How we handle patient data
      </a>
    </p>
  </section>

  {
    latest && (
      <section class="bg-mist">
        <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
          <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">From our research.</h2>
          <a
            href={withBase(`/research/${latest.id}/`)}
            class="group mt-12 grid gap-8 no-underline lg:grid-cols-12 lg:items-center lg:gap-10"
          >
            <div class="aspect-[16/10] overflow-hidden rounded-sm lg:col-span-7">
              <FlowArt seed={`research/${latest.id}`} />
            </div>
            <div class="lg:col-span-5">
              <h3 class="text-[1.75rem] leading-[1.18] transition-colors group-hover:text-navy-700 md:text-[2.125rem]">
                {latest.data.title}
              </h3>
              <p class="mt-4 text-lg leading-relaxed text-graphite-700">{latest.data.description}</p>
              <p class="mt-6 font-medium text-navy-950 underline decoration-signal-500 decoration-1 underline-offset-[6px] group-hover:decoration-2">
                Read the report
              </p>
            </div>
          </a>
        </div>
      </section>
    )
  }
</Layout>

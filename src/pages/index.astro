---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";

const decisions = [
  "Which patients to bring back into care, and when",
  "Where clinical capacity is going unused",
  "Which growth investments are actually paying back",
];

const outcomes = [
  {
    title: "Patients who stay in care",
    body: "Lapsing patients are noticed early and re-engaged before they are lost, so continuity of care and revenue hold together.",
  },
  {
    title: "A fuller, steadier schedule",
    body: "See where capacity goes unused — by practitioner, day and service — and act on it while the week can still be saved.",
  },
  {
    title: "Revenue you can explain",
    body: "Understand what each service, payer and practitioner contributes, and where receivables are quietly ageing.",
  },
  {
    title: "Growth decided on evidence",
    body: "Tie marketing spend, hiring and expansion to the bookings and outcomes they actually produce.",
  },
];

const engagement = [
  {
    name: "Diagnose",
    body: "A Practice Health Snapshot built from your own data: utilisation, patient attrition, revenue mix, and where value is leaking.",
  },
  {
    name: "Prioritise",
    body: "Together we agree the few measures that matter most for your clinic, and targets you can hold us to.",
  },
  {
    name: "Activate",
    body: "Datafore connects to the systems you already run, so findings become coordinated follow-up rather than another report.",
  },
  {
    name: "Review",
    body: "Regular reviews of what moved, what didn't, and what to do next — the same discipline your practitioners apply to care.",
  },
];

const principles = [
  {
    title: "Held in Canada",
    body: "Clinic data is designed to be stored and processed in Canadian data centres.",
  },
  {
    title: "Private by design",
    body: "Analysis runs on de-identified records; names and contact details stay out of the analytics layer.",
  },
  {
    title: "Accountable AI",
    body: "Every recommendation traces back to the data behind it, and people decide what happens next.",
  },
];
---

<Layout
  title="Datafore"
  description="Datafore helps Canadian allied health clinics turn the data they already hold into clear decisions on retention, capacity and growth — and makes sure those decisions are acted on."
>
  <!-- Hero -->
  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto grid max-w-7xl gap-14 px-6 pb-24 pt-20 md:pt-28 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:pb-32">
      <div class="settle lg:col-span-8">
        <h1 class="text-[2.75rem] leading-[1.04] tracking-[-0.022em] text-white sm:text-6xl lg:text-[5rem]">
          Clinic intelligence for the business of care.
        </h1>
        <p class="mt-8 max-w-[58ch] text-lg leading-relaxed md:text-xl">
          Datafore helps Canadian allied health clinics turn the data they already hold into clear decisions on
          retention, capacity and growth — and makes sure those decisions are acted on.
        </p>
        <div class="mt-11 flex flex-wrap items-center gap-x-8 gap-y-4">
          <a
            href={withBase("/contact/")}
            class="rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Start a conversation
          </a>
          <a
            href={withBase("/platform/")}
            class="font-medium text-white underline decoration-signal-300 decoration-1 underline-offset-[6px] hover:decoration-2"
          >
            How we work with clinics
          </a>
        </div>
      </div>

      <aside class="settle-late self-end border-t border-navy-700 pt-6 lg:col-span-4 lg:border-l lg:border-t-0 lg:pl-10 lg:pt-0">
        <h2 class="font-sans text-sm font-semibold tracking-normal text-white">The decisions we help leaders make</h2>
        <ul class="mt-5 divide-y divide-navy-800">
          {
            decisions.map((d) => (
              <li class="py-4 font-display text-xl leading-snug text-navy-100">{d}</li>
            ))
          }
        </ul>
      </aside>
    </div>
  </section>

  <!-- The opportunity -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">
        Allied health clinics are rich in data and short on insight.
      </h2>
      <div class="space-y-6 text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        <p>
          Practice management systems record every appointment, invoice and cancellation. They were built to run
          the day, not to steer the business — so the decisions that shape a clinic's future, from hiring and hours
          to marketing and new locations, are made on instinct and month-end spreadsheets.
        </p>
        <p>
          The cost is quiet but real. No-shows, unfilled hours and patients who simply stop coming are estimated to
          cost clinics between ten and twenty percent of their revenue — and with it, continuity of care for the
          people they serve.
        </p>
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <h2 class="max-w-[22ch] text-[2rem] leading-[1.12] md:text-[2.75rem]">What clinic leaders gain.</h2>
      <div class="mt-16 grid gap-x-16 gap-y-12 md:grid-cols-2">
        {
          outcomes.map((o) => (
            <div class="border-t border-navy-200 pt-6">
              <h3 class="text-2xl leading-snug">{o.title}</h3>
              <p class="mt-3 max-w-[48ch] leading-relaxed text-graphite-700">{o.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Point of view -->
  <section class="bg-navy-900 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
      <blockquote class="max-w-5xl">
        <p class="font-display text-[1.875rem] leading-[1.2] text-white md:text-[2.75rem] lg:text-[3.25rem]">
          Practice software is built to record care. Clinic leaders need something that helps them run the
          business of care.
        </p>
      </blockquote>
      <p class="mt-10 max-w-[62ch] text-lg leading-relaxed">
        That is the gap Datafore exists to close: an intelligence layer above the systems you already use, which
        doesn't stop at a report. It turns findings into coordinated action, and shows you what that action
        returned.
      </p>
    </div>
  </section>

  <!-- Engagement model -->
  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">A partner, not another dashboard.</h2>
      </div>
      <p class="text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        We work alongside clinic leaders in a deliberate sequence, the way a good clinician works with a patient:
        understand first, agree what matters, act, and then check honestly whether it worked.
      </p>
    </div>

    <ol class="mt-16 grid gap-10 md:grid-cols-2 lg:grid-cols-4 lg:gap-8">
      {
        engagement.map((s) => (
          <li class="border-t-2 border-navy-900 pt-6">
            <h3 class="text-2xl">{s.name}</h3>
            <p class="mt-3 leading-relaxed text-graphite-700">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Trust -->
  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">Built to be trusted with patient data.</h2>
          <p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-graphite-700">
            Health information is the most sensitive thing a clinic holds. Stewardship is designed into how Datafore
            works, not added as a policy afterwards.
          </p>
          <a
            href={withBase("/trust/")}
            class="mt-8 inline-block font-medium text-navy-800 underline decoration-signal-500 underline-offset-[6px] hover:decoration-2"
          >
            Our approach to trust and governance
          </a>
        </div>
        <div class="grid gap-10 sm:grid-cols-3 lg:col-span-6 lg:col-start-7 lg:gap-8">
          {
            principles.map((p) => (
              <div class="border-t border-navy-200 pt-6">
                <h3 class="font-sans text-base font-semibold tracking-normal">{p.title}</h3>
                <p class="mt-2 leading-relaxed text-graphite-700">{p.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Founding cohort -->
  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-[2rem] leading-[1.12] text-white md:text-[3rem]">Shape Datafore with us.</h2>
          <p class="mt-6 max-w-[56ch] text-lg leading-relaxed">
            We are inviting a small number of allied health clinics in British Columbia to join our founding cohort,
            beginning with a complimentary Practice Health Snapshot of your own data.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-x-8 gap-y-4 lg:col-span-5 lg:justify-end">
          <a
            href={withBase("/contact/")}
            class="rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Request a Practice Health Snapshot
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

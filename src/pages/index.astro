---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
import Seal from "../components/Seal.astro";

const disciplines = [
  "Physiotherapy",
  "Chiropractic",
  "Massage Therapy",
  "Occupational Therapy",
  "Speech-Language Pathology",
  "Kinesiology",
  "Acupuncture & TCM",
  "Counselling Therapy",
  "Podiatry",
  "Dietetics",
];

const pillars = [
  {
    code: "DF-01",
    title: "Analytics",
    body: "Utilization, cancellations, revenue by payer, and outcomes over time, read from the scheduling and billing data your clinic already produces.",
    glyph: "M38 60 L38 44 M50 60 L50 36 M62 60 L62 50",
  },
  {
    code: "DF-02",
    title: "Marketing Technology",
    body: "Tools built to help allied health clinics attract and retain patients, grounded in what actually moves a multi-discipline practice.",
    glyph: "M38 52 L38 58 L44 58 L54 65 L54 39 L44 46 L38 46 Z M58 46 C61 48 61 56 58 58",
  },
  {
    code: "DF-03",
    title: "CRM Enablement",
    body: "Patient and lead relationships managed the way clinics actually operate, not a generic sales pipeline repurposed for healthcare.",
    glyph: "M50 44 L38 58 M50 44 L62 58 M50 44 L50 60 M38 58 h24",
  },
  {
    code: "DF-04",
    title: "AI Technology Partner",
    body: "Applied AI across analytics, marketing, and CRM: a working partner embedded in the platform, not a chatbot bolted on top.",
    glyph: "M40 40 h20 v20 h-20 Z M40 40 L34 34 M60 40 L66 34 M40 60 L34 66 M60 60 L66 66",
  },
];

const stages = [
  {
    mark: "CONNECT",
    body: "We work with your clinic to bring scheduling, billing, and intake data together securely.",
  },
  {
    mark: "VERIFY",
    body: "Datafore checks and reconciles it, so what you're looking at is trustworthy, not a rough estimate.",
  },
  {
    mark: "CERTIFY",
    body: "You get a clear, standing record of how the clinic is performing, one you can act on this week.",
  },
];
---

<Layout
  title="Datafore"
  description="Datafore is building a growth and operations platform for allied health clinics in British Columbia: analytics, marketing technology, CRM enablement, and applied AI."
>
  <!-- HERO -->
  <section class="relative overflow-hidden border-b border-ink-200 bg-paper">
    <div class="mx-auto grid max-w-6xl gap-16 px-6 py-20 md:grid-cols-2 md:items-center md:py-28">
      <div>
        <h1 class="text-4xl font-bold leading-[1.05] tracking-tight text-ink-950 md:text-5xl">
          Your clinic's numbers deserve the same rigor as your license.
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink-600">
          Datafore is building a growth and operations platform for allied health clinics in BC: analytics,
          marketing technology, CRM enablement, and applied AI, verified and standing, not another chart wall.
        </p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a
            href={withBase("/contact/")}
            class="rounded bg-ink-950 px-6 py-3 font-mono text-sm uppercase tracking-[0.08em] text-white transition-colors hover:bg-seal-700"
          >
            Join early access
          </a>
          <a
            href={withBase("/platform/")}
            class="rounded border border-ink-300 px-6 py-3 font-mono text-sm uppercase tracking-[0.08em] text-ink-700 transition-colors hover:border-ink-950 hover:text-ink-950"
          >
            See the platform
          </a>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-sm md:mx-0" style="perspective: 1200px;">
        <div class="credential-card relative rounded-lg border border-ink-200 bg-white p-6 shadow-[0_1px_2px_rgba(16,15,13,0.04),0_16px_40px_-16px_rgba(16,15,13,0.25)]">
          <div class="flex items-start justify-between">
            <div>
              <p class="credential-label text-seal-600">Datafore Verified</p>
              <p class="mt-1 font-mono text-xs text-ink-500">REG. NO. DF-2026-0417</p>
            </div>
            <Seal size={44} class="text-seal-500">
              <path d="M42 36 L42 64 M42 36 C54 36 60 42 60 50 C60 58 54 64 42 64" />
            </Seal>
          </div>

          <dl class="mt-8 space-y-5 border-t border-ink-100 pt-6">
            <div class="flex items-center justify-between">
              <dt class="text-sm text-ink-500">Utilization</dt>
              <dd class="font-mono text-sm font-semibold text-ink-950">84%</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-sm text-ink-500">New patients, QTD</dt>
              <dd class="font-mono text-sm font-semibold text-ink-950">+12%</dd>
            </div>
            <div class="flex items-center justify-between">
              <dt class="text-sm text-ink-500">Avg. claim cycle</dt>
              <dd class="font-mono text-sm font-semibold text-ink-950">9 days</dd>
            </div>
          </dl>

          <p class="mt-8 border-t border-ink-100 pt-4 font-mono text-[0.6875rem] uppercase tracking-[0.1em] text-ink-500">
            Illustrative sample &middot; composite BC multi-discipline clinic
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- WHO IT'S FOR -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="max-w-2xl text-2xl font-semibold text-ink-950 md:text-3xl">
      Designed around how multi-disciplinary clinics in BC actually run.
    </h2>
    <div class="mt-8 flex flex-wrap gap-2">
      {
        disciplines.map((d) => (
          <span class="rounded border border-ink-200 px-3.5 py-1.5 font-mono text-xs uppercase tracking-wide text-ink-600">
            {d}
          </span>
        ))
      }
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="border-y border-ink-200 bg-ink-950 text-ink-200">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <div class="grid gap-10 md:grid-cols-2 md:gap-16">
        <h2 class="text-2xl font-semibold text-white md:text-3xl">
          Practice management software wasn't built to answer "how are we really doing?"
        </h2>
        <p class="text-lg leading-relaxed text-ink-300">
          Scheduling and billing systems keep the clinic running, but they weren't designed for performance
          reporting, patient growth, or relationship management. Owners end up stitching answers together from
          spreadsheets and gut feel, especially once a clinic spans multiple disciplines, practitioners, or
          locations. Datafore exists to close that gap, as one connected platform.
        </p>
      </div>
    </div>
  </section>

  <!-- PILLARS -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="max-w-2xl text-2xl font-semibold text-ink-950 md:text-3xl">Four credentialed capabilities.</h2>
    <div class="mt-10 grid gap-px overflow-hidden rounded-lg border border-ink-200 bg-ink-200 sm:grid-cols-2">
      {
        pillars.map((p) => (
          <div class="bg-white p-8">
            <div class="flex items-center gap-4">
              <Seal size={52} class="shrink-0 text-seal-600">
                <path d={p.glyph} />
              </Seal>
              <div>
                <p class="font-mono text-xs text-ink-500">CRED. NO. {p.code}</p>
                <h3 class="mt-0.5 text-lg font-semibold text-ink-950">{p.title}</h3>
              </div>
            </div>
            <p class="mt-4 text-sm leading-relaxed text-ink-600">{p.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- STAGES -->
  <section class="border-t border-ink-200 bg-paper-dim">
    <div class="mx-auto max-w-6xl px-6 py-16">
      <h2 class="max-w-2xl text-2xl font-semibold text-ink-950 md:text-3xl">How a clinic gets certified.</h2>
      <div class="relative mt-12 grid gap-10 md:grid-cols-3">
        <div class="absolute top-[13px] left-0 right-0 hidden h-px bg-ink-300 md:block" aria-hidden="true"></div>
        {
          stages.map((s) => (
            <div class="relative">
              <div class="relative z-10 flex items-center gap-3">
                <span class="h-[9px] w-[9px] shrink-0 rounded-full border-2 border-seal-600 bg-paper-dim" />
                <span class="font-mono text-xs font-semibold uppercase tracking-[0.14em] text-seal-700">
                  {s.mark}
                </span>
              </div>
              <p class="mt-3 text-sm leading-relaxed text-ink-600">{s.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-6xl px-6 py-20 text-center">
    <h2 class="text-3xl font-semibold text-ink-950">Help shape the platform.</h2>
    <p class="mx-auto mt-4 max-w-xl text-ink-600">
      We're building alongside a small group of founding BC clinics. If you run, or work in, an allied health
      practice, we'd like to hear how you measure performance today.
    </p>
    <a
      href={withBase("/contact/")}
      class="mt-8 inline-block rounded bg-ink-950 px-8 py-3 font-mono text-sm uppercase tracking-[0.08em] text-white transition-colors hover:bg-seal-700"
    >
      Talk to Datafore
    </a>
  </section>
</Layout>

<style>
  @keyframes stamp-in {
    from {
      opacity: 0;
      transform: scale(1.06) rotate(-1.5deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(-1.5deg);
    }
  }

  .credential-card {
    animation: stamp-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform: rotate(-1.5deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .credential-card {
      animation: none;
    }
  }
</style>

---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";
import SystemDiagram from "../components/SystemDiagram.astro";

const capabilities = [
  {
    name: "Understand",
    lead: "See the whole clinic in one place.",
    body: "Appointments, patients, invoices and payments from your practice management system, combined into one view across practitioners, services and locations.",
  },
  {
    name: "Anticipate",
    lead: "Spot problems before month-end.",
    body: "Patients drifting out of care, recurring gaps in the schedule, no-shows by practitioner, overdue invoices by payer. Flagged as they happen, not after the quarter closes.",
  },
  {
    name: "Act",
    lead: "Turn findings into follow-up.",
    body: "Datafore creates follow-up tasks in the CRM your team already uses, so the right patients hear from you and someone owns each task.",
  },
  {
    name: "Prove",
    lead: "See what each action brought in.",
    body: "New bookings are traced back to the follow-up or campaign that prompted them, so you know which efforts pay off.",
  },
];

---

<Layout
  title="Platform"
  description="Datafore works on top of your practice management system: it combines your clinic data, flags what needs attention, turns it into follow-up, and tracks the result."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="max-w-[18ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4rem]">
        Works on top of the software you already use.
      </h1>
      <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Your practice management system is good at recording appointments and invoices. Datafore reads that data,
        flags what needs attention, makes sure someone follows up, and checks whether it worked.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
    <ol class="divide-y divide-navy-100 border-y border-navy-100">
      {
        capabilities.map((c) => (
          <li class="grid gap-4 py-10 lg:grid-cols-12 lg:gap-10 lg:py-14">
            <h2 class="text-[2rem] leading-[1.1] md:text-[2.5rem] lg:col-span-4">{c.name}</h2>
            <div class="max-w-[58ch] lg:col-span-7 lg:col-start-6">
              <p class="text-xl font-medium leading-snug text-navy-950">{c.lead}</p>
              <p class="mt-3 text-lg leading-relaxed text-graphite-700">{c.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-mist">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">Works with the systems clinics use.</h2>
        <p class="text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
          Your team keeps working the way it does today. We're connecting systems one at a time during our founding
          phase, starting with Jane App.
        </p>
      </div>
      <div class="mt-14">
        <SystemDiagram />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">Benchmarks, as more clinics join.</h2>
      <div class="space-y-6 text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        <p>
          At first, Datafore compares your clinic with itself: practitioner to practitioner, month to month. As more
          clinics join, it will show how your retention and utilisation compare with similar practices.
        </p>
        <p>
          No such benchmark exists for allied health in Canada today. We'll publish one only when enough clinics take
          part to make it meaningful and keep every clinic anonymous.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-[2rem] leading-[1.12] text-white md:text-[3rem]">Where we are today.</h2>
          <p class="mt-6 max-w-[58ch] text-lg leading-relaxed">
            Datafore is in active development. We're looking for a small group of BC clinics to help shape it.
          </p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          <a
            href={withBase("/contact/")}
            class="inline-block rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Start a conversation
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

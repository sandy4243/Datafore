---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/paths";

const capabilities = [
  {
    name: "Understand",
    lead: "One clear view of the clinic.",
    body: "Appointments, patients, invoices and payments are brought together from your practice management system into a single, consistent picture — across practitioners, services and locations, whichever system each one runs.",
  },
  {
    name: "Anticipate",
    lead: "The signals that matter, before month-end.",
    body: "Patients drifting out of care, recurring gaps in the schedule, no-shows clustering by practitioner, receivables ageing by payer. The early signs that decide whether a quarter goes well — surfaced as they emerge.",
  },
  {
    name: "Act",
    lead: "Findings become follow-up.",
    body: "Insight that stops at a report is still work waiting to happen. Datafore writes the follow-up into the CRM your team already uses, so the right patients are re-engaged and the right people are asked to act.",
  },
  {
    name: "Prove",
    lead: "See what each action returned.",
    body: "Bookings are traced back to the action that prompted them. The question shifts from whether the work is worth it to how much it returned — and marketing spend becomes accountable to real appointments, not clicks.",
  },
];

const systems = [
  { name: "Jane App", role: "Practice management" },
  { name: "Cliniko", role: "Practice management" },
  { name: "Owl Practice", role: "Practice management" },
  { name: "HubSpot", role: "CRM and patient communication" },
];
---

<Layout
  title="Platform"
  description="Datafore is an intelligence layer above the practice management systems clinics already run: it brings clinic data together, surfaces what matters, turns findings into follow-up, and shows what that follow-up returned."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="max-w-[18ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4rem]">
        One intelligence layer above the systems you already run.
      </h1>
      <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Practice management systems are systems of record. They are good at it. Datafore is the layer above them
        that reads what they hold, decides what needs attention, sees that it gets done, and checks whether it
        worked.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
    <ol class="divide-y divide-navy-100 border-y border-navy-100">
      {
        capabilities.map((c) => (
          <li class="grid gap-4 py-10 lg:grid-cols-12 lg:gap-10 lg:py-14">
            <h2 class="text-[2rem] leading-[1.1] md:text-[2.5rem] lg:col-span-4">{c.name}</h2>
            <div class="max-w-[58ch] lg:col-span-7 lg:col-start-6">
              <p class="text-xl font-medium leading-snug text-navy-950">{c.lead}</p>
              <p class="mt-3 text-lg leading-relaxed text-graphite-700">{c.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="bg-mist">
    <div class="mx-auto grid max-w-7xl gap-12 px-6 py-24 lg:grid-cols-12 lg:px-10 lg:py-28">
      <div class="lg:col-span-5">
        <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem]">Designed for the systems clinics use.</h2>
        <p class="mt-6 max-w-[48ch] text-lg leading-relaxed text-graphite-700">
          Datafore sits above your software rather than replacing it. Your team keeps working the way it does today.
          Connections are being brought online system by system through our founding phase, starting with Jane App.
        </p>
      </div>
      <dl class="grid gap-px self-start overflow-hidden rounded-sm border border-navy-100 bg-navy-100 sm:grid-cols-2 lg:col-span-6 lg:col-start-7">
        {
          systems.map((s) => (
            <div class="bg-paper p-6">
              <dt class="font-display text-xl text-navy-950">{s.name}</dt>
              <dd class="mt-1 text-graphite-600">{s.role}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
    <div class="grid gap-10 lg:grid-cols-12">
      <h2 class="text-[2rem] leading-[1.12] md:text-[2.75rem] lg:col-span-5">It becomes more valuable as it grows.</h2>
      <div class="space-y-6 text-lg leading-relaxed text-graphite-700 lg:col-span-6 lg:col-start-7">
        <p>
          On day one, Datafore compares your clinic with itself: practitioner to practitioner, month to month. As
          more Canadian clinics join, that comparison can extend outward — how your retention or utilisation sits
          against comparable practices, and what the strongest performers do differently.
        </p>
        <p>
          No such benchmark exists for Canadian allied health today, and a single software vendor is poorly placed
          to build one. A neutral layer that sits above every system is not. We will publish benchmarks only once
          enough clinics take part to make them meaningful and to keep every clinic anonymous.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto max-w-7xl px-6 py-24 lg:px-10 lg:py-28">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h2 class="text-[2rem] leading-[1.12] text-white md:text-[3rem]">Where Datafore is today.</h2>
          <p class="mt-6 max-w-[58ch] text-lg leading-relaxed">
            The platform is in active development, and we are forming a founding cohort of clinics in British
            Columbia to shape it. We would rather tell you that plainly than imply a finished product.
          </p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          <a
            href={withBase("/contact/")}
            class="inline-block rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
          >
            Start a conversation
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

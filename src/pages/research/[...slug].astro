---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../lib/paths";

export async function getStaticPaths() {
  const reports = await getCollection("reports", ({ data }) => !data.draft);
  return reports.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
// Figure components read this to find the report's data and source line.
Astro.locals.report = { id: entry.data.data ?? entry.id, source: entry.data.source.short };
const { Content } = await render(entry);
const date = (d: Date) => d.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" });
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article>
    <header class="border-b border-navy-100">
      <div class="mx-auto max-w-4xl px-6 pb-14 pt-16 md:pt-24">
        <a href={withBase("/research/")} class="text-sm font-medium text-navy-800 underline decoration-signal-500 underline-offset-4">
          All research
        </a>
        <h1 class="mt-8 text-[2.5rem] leading-[1.08] tracking-[-0.02em] md:text-[3.5rem]">{entry.data.title}</h1>
        <p class="mt-6 max-w-[60ch] text-lg leading-relaxed text-graphite-700 md:text-xl">{entry.data.description}</p>
        <p class="mt-8 flex flex-wrap gap-x-2 text-sm text-graphite-600">
          <span class="font-semibold text-navy-950">{entry.data.author}</span>
          <span aria-hidden="true" class="text-graphite-300">/</span>
          <time datetime={entry.data.publishDate.toISOString()} class="figures">{date(entry.data.publishDate)}</time>
          <span aria-hidden="true" class="text-graphite-300">/</span>
          <span>Data: {entry.data.source.short}</span>
        </p>
      </div>
    </header>

    <div class="mx-auto max-w-4xl px-6 py-14 md:py-20">
      <div class="prose prose-lg max-w-none [&>:not(figure,section)]:max-w-[68ch]">
        <Content />
      </div>

      <section class="mt-20 border-t border-navy-200 pt-8 text-sm leading-relaxed text-graphite-700">
        <h2 class="font-sans text-base font-semibold text-navy-950">Source and method</h2>
        <p class="mt-3 max-w-[72ch]">
          {entry.data.source.citation}
          {
            entry.data.source.url && (
              <>
                {" "}
                <a href={entry.data.source.url} class="text-navy-800 underline decoration-signal-500 underline-offset-4">
                  View the source
                </a>
                .
              </>
            )
          }
        </p>
        <p class="mt-3 max-w-[72ch]">
          Datafore reads the published tables with SQL in DuckDB; the explorer runs the same queries in your browser.
          The figures are the publisher's. The analysis and wording are Datafore's, and this report is not affiliated
          with or endorsed by the publisher.
        </p>
        {
          entry.data.updatedDate && (
            <p class="mt-3">
              Updated <time datetime={entry.data.updatedDate.toISOString()} class="figures">{date(entry.data.updatedDate)}</time>.
            </p>
          )
        }
      </section>
    </div>
  </article>

  <section class="bg-navy-950 text-navy-200">
    <div class="mx-auto grid max-w-7xl gap-10 px-6 py-20 lg:grid-cols-12 lg:items-end lg:px-10">
      <div class="lg:col-span-7">
        <h2 class="text-[2rem] leading-[1.12] text-white md:text-[2.75rem]">See your own clinic this clearly.</h2>
        <p class="mt-5 max-w-[56ch] text-lg leading-relaxed">
          A Practice Health Snapshot applies the same method to your clinic's own data.
        </p>
      </div>
      <div class="lg:col-span-5 lg:text-right">
        <a
          href={withBase("/contact/?topic=snapshot#message")}
          class="inline-block rounded-sm bg-white px-6 py-3.5 font-medium text-navy-950 transition-colors hover:bg-navy-100"
        >
          Request a Snapshot
        </a>
      </div>
    </div>
  </section>
</Layout>

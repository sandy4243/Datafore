---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/paths";

const reports = (await getCollection("reports", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
---

<Layout
  title="Research"
  description="Datafore's analysis of public data on allied health in Canada, with charts you can explore."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4.5rem]">Research.</h1>
      <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Our analysis of public data on allied health in Canada. Every chart cites its source, and you can explore the
        data yourself.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
    {reports.length === 0 && <p class="text-lg text-graphite-700">The first report is on its way.</p>}
    <ul class="divide-y divide-navy-100 border-y border-navy-100">
      {
        reports.map((r) => (
          <li>
            <a href={withBase(`/research/${r.id}/`)} class="group grid gap-3 py-10 no-underline lg:grid-cols-12 lg:gap-10">
              <div class="text-sm text-graphite-600 lg:col-span-3 lg:pt-2">
                <time datetime={r.data.publishDate.toISOString()} class="figures block">
                  {r.data.publishDate.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" })}
                </time>
                <span class="mt-1 block">Data: {r.data.source.short}</span>
              </div>
              <div class="lg:col-span-8">
                <h2 class="text-[1.75rem] leading-[1.18] transition-colors group-hover:text-navy-700 md:text-[2.125rem]">
                  {r.data.title}
                </h2>
                <p class="mt-3 max-w-[62ch] text-lg leading-relaxed text-graphite-700">{r.data.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../lib/paths";

// Research reports and articles share one index, newest first.
const reports = await getCollection("reports", ({ data }) => !data.draft);
const posts = await getCollection("blog", ({ data }) => !data.draft);
const items = [
  ...reports.map((r) => ({
    href: withBase(`/research/${r.id}/`),
    kind: "Research",
    title: r.data.title,
    description: r.data.description,
    date: r.data.publishDate,
    detail: `Data: ${r.data.source.short}`,
  })),
  ...posts.map((p) => ({
    href: withBase(`/blog/${p.id}/`),
    kind: "Article",
    title: p.data.title,
    description: p.data.description,
    date: p.data.publishDate,
    detail: p.data.author,
  })),
].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---

<Layout
  title="Research & Insights"
  description="Datafore's analysis of public data on allied health in Canada, and notes on running a clinic by the numbers."
>
  <section class="border-b border-navy-100">
    <div class="mx-auto max-w-7xl px-6 pb-20 pt-20 md:pt-28 lg:px-10">
      <h1 class="max-w-[16ch] text-[2.75rem] leading-[1.05] tracking-[-0.022em] sm:text-6xl lg:text-[4.5rem]">
        Research &amp; Insights.
      </h1>
      <p class="mt-8 max-w-[58ch] text-lg leading-relaxed text-graphite-700 md:text-xl">
        Our analysis of public data on allied health in Canada, and notes on running a clinic by the numbers.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10 lg:py-24">
    {items.length === 0 && <p class="text-lg text-graphite-700">New work is on the way.</p>}
    <ul class="divide-y divide-navy-100 border-y border-navy-100">
      {
        items.map((item) => (
          <li>
            <a href={item.href} class="group grid gap-3 py-10 no-underline lg:grid-cols-12 lg:gap-10">
              <div class="text-sm text-graphite-600 lg:col-span-3 lg:pt-2">
                <span class="block font-semibold text-navy-950">{item.kind}</span>
                <time datetime={item.date.toISOString()} class="figures mt-1 block">
                  {item.date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric" })}
                </time>
                <span class="mt-1 block">{item.detail}</span>
              </div>
              <div class="lg:col-span-8">
                <h2 class="text-[1.75rem] leading-[1.18] transition-colors group-hover:text-navy-700 md:text-[2.125rem]">
                  {item.title}
                </h2>
                <p class="mt-3 max-w-[62ch] text-lg leading-relaxed text-graphite-700">{item.description}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
